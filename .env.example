# Postgres. Locally: `docker compose up -d --wait` (see docker-compose.yml).
# Deployed: Neon free tier.
# Prisma migrations need a direct connection, not a pooled one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_platform"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Admin login allowlist. This demo has one business and one admin; anyone else
# who requests a login link is rejected.
ALLOWED_LOGIN_EMAILS=""

# Email delivery (confirmations, reminders, login links). Unset in local dev
# prints login links to the terminal instead of sending them.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""

# Public origin for links in emails. On Vercel it falls back to the production
# domain if unset; set it explicitly once the custom domain is live.
APP_URL="http://localhost:3000"

# The public demo: never send email (anyone can type any address), show the
# email on the confirmation page instead, and show a demo banner. Leave unset
# for a real deployment.
DEMO_MODE="true"
