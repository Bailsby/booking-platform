# Postgres (Neon or Supabase free tier in deployment; local Postgres in dev).
# Prisma migrations need a direct connection, not a pooled one.
DATABASE_URL="postgresql://user:password@localhost:5432/booking_platform"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Admin login allowlist. This demo has one business and one admin; anyone else
# who requests a login link is rejected.
ALLOWED_LOGIN_EMAILS=""

# Email delivery (confirmations, reminders, login links). Unset in local dev
# prints login links to the terminal instead of sending them.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""
